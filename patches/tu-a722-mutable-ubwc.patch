+/* Duo build: A722 keeps UBWC on mutable-format images, as Vauzi's Turnip-Z
+ * does, although it lacks ubwc_all_formats_compatible: a view in another
+ * format may decode the compressed data wrongly. TU_MUTABLE_UBWC=0 restores
+ * upstream behaviour.
+ */
+DEBUG_GET_ONCE_BOOL_OPTION(mutable_ubwc, "TU_MUTABLE_UBWC", true)
+
+static bool
+a722_keep_mutable_ubwc(struct tu_device *dev,
+                       const VkImageFormatListCreateInfo *fmt_list,
+                       const VkImageCreateInfo *create_info)
+{
+   return (dev->physical_device->dev_id.chip_id & 0xffffffff) == 0x43020100 &&
+          debug_get_option_mutable_ubwc() &&
+          format_list_ubwc_possible(dev, fmt_list, create_info);
+}
+
