diff --git a/src/freedreno/vulkan/00-turnip-defaults.conf b/src/freedreno/vulkan/00-turnip-defaults.conf
index da85f99..f46d276 100644
--- a/src/freedreno/vulkan/00-turnip-defaults.conf
+++ b/src/freedreno/vulkan/00-turnip-defaults.conf
@@ -156,5 +156,11 @@
         <application name="Sweet Surrender" application_name_match="Sweet Surrender VR.exe">
             <option name="tu_autotune_algorithm" value="prefer_gmem" />
         </application>
+        <application name="Cemu" application_name_match="[Cc]emu">
+            <!-- Cemu (Wii U) on Adreno 722: system-memory rendering was measured faster than GMEM
